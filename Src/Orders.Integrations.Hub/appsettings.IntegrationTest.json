{
  "ConnectionStrings": {
    "RabbitMq": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Clients": {
    "Internal": {
      "BaseUrl": "http://localhost:5001"
    },
    "Orders": {
      "BaseUrl": "http://localhost:5002"
    }
  },
  "MessageBroker": {
    "Provider": "Memory",
    "Retry": {
      "RetryLimit": 1,
      "MinIntervalSeconds": 1,
      "MaxIntervalSeconds": 1,
      "IntervalDeltaSeconds": 1
    },
    "CircuitBreaker": {
      "TrackingPeriodMinutes": 1,
      "TripThreshold": 15,
      "ActiveThreshold": 10,
      "ResetIntervalMinutes": 5
    }
  },
  "Cache": {
    "Provider": "Memory"
  },
  "PubSub": {
    "Provider": "Sns",
    "Topics": {
      "AcceptOrder": "arn:aws:sns:us-east-1:000000000000:accept-order"
    }
  },
  "ObjectStorage": {
    "Provider": "S3",
    "Bucket": {
      "Name": "s3-local-bucket"
    }
  },
  "Providers": {
    "Aws": {
      "Region": "us-east-1",
      "Profile": "test",
      "ServiceUrlOverride": "http://localhost:4566",
      "ForcePathStyle": true
    }
  },
  "Integrations": {
    "IFood": {
      "Client": {
        "Id": "test-ifood-id",
        "Secret": "test-secret"
      },
      "Endpoint": {
        "BaseUrl": "http://localhost:5003"
      }
    },
    "Rappi": {
      "Client": {
        "Id": "test-rappi-secret",
        "Secret": "test-rappi-secret",
        "Audience": "test-audience"
      },
      "Endpoint": {
        "BaseUrl": "http://localhost:5004",
        "AuthUrl": "http://localhost:5005"
      }
    },
    "Food99": {
      "Client": {
        "Id": "test-food99-secret",
        "Secret": "test-99-secret"
      },
      "Endpoint": {
        "BaseUrl": "http://localhost:5006"
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Orders.Integrations.Hub.IntegrationTests",
    "Endpoint": "http://localhost:4318",
    "Protocol": "HttpProtobuf"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Http.Resilience": "Warning",
      "System.Net.Http.HttpClient.OtlpLogExporter": "None",
      "System.Net.Http.HttpClient.OtlpTraceExporter": "None",
      "System.Net.Http.HttpClient.OtlpMetricExporter": "None",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*"
}
