<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
        <Description>Orders Integrations Hub</Description>
        <NoWarn>CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Http" Version="10.2.3" />
        <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
        <PackageReference Include="Asp.Versioning.OpenApi" Version="10.2.3" />
        <PackageReference Include="AWSSDK.Core" Version="4.0.102.2" />
        <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100.11" />
        <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
        <PackageReference Include="AWSSDK.SQS" Version="4.0.100.11" />
        <PackageReference Include="DotNetEnv" Version="3.2.0"/>
        <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.10" />
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AWS" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.16.0-beta.1" />
        <PackageReference Include="Refit" Version="15.2.0" />
        <PackageReference Include="Refit.HttpClientFactory" Version="15.2.0" />
        <PackageReference Include="Refit.Reflection" Version="15.2.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
        <PackageReference Include="Scrutor" Version="7.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Integrations\Keeta\Adapters\"/>
        <Folder Include="Integrations\Keeta\Application\Handlers\"/>
        <Folder Include="Integrations\Keeta\Application\Ports\"/>
        <Folder Include="Integrations\Keeta\Infrastructure\"/>
    </ItemGroup>

</Project>
